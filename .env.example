# ==============================================================================
# Tencio Menu Hub - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` or `.env` and fill in the appropriate secrets.
# Do NOT commit `.env` or `.env.local` containing actual secrets into source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key (Keep secret! Used exclusively on the server for admin actions)
# Found in Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL database connection strings (Optional / Prisma / Migrations)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. Web Push Notifications (VAPID)
# ------------------------------------------------------------------------------
# Used for background table service call notifications to cafe devices.
# Generate a new pair by running: `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ------------------------------------------------------------------------------
# 3. Super Admin Credentials
# ------------------------------------------------------------------------------
# Used to access the platform-level Super Admin control panel at `/superadmin/login`
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=your-super-admin-secure-password
